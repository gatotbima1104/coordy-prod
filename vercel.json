{
  "version": 2,
  "builds": [
    { "src": "src/server.ts", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/apple-app-site-association",
      "dest": "src/server.ts"
    },
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ],
  "redirects": [
    {
      "source": "https://www.groev.site/(.*)",
      "destination": "https://groev.site/$1",
      "permanent": true
    }
  ]
}