// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init// prisma/schema.prisma
generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum StatusVote {
    PENDING
    SUBMITTED
}

enum StatusCard {
    // DRAFT
    WAITING_RESPONSE // pertama kali dibuat
    NEED_ACTION // kalo udah masuk semua stakeholder
    COMPLETED // kalo udah schedule dan pick waktu interesection
    CANCELLED // Ga ketemu irisannya
}

enum StatusLocation {
    ONSITE
    REMOTE
}

enum StatusNotification {
    UNREAD
    READ
}

enum TypeNotification {
    INVITE
    REMINDER
    RESPONSE
    DELETE
    CREATE
    UPDATE
}

enum Duration {
    QUARTER
    HALF
    THREE_QUARTER
    HOUR
}

enum PriorityStatus {
    LOW
    MEDIUM
    HIGH
}

enum TimeZone {
  UTC
  GMT
  WIB
  WITA
  WIT
  PST
  EST
  CET
  JST
  AEST
}

model User {
    id              String  @id @default(uuid())
    supabaseId      String  @unique
    email           String?
    events          Event[]
    devices         Device[]
    notifications   Notification[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@map("users")
}

model Device {
    id      String @id @default(uuid())
    token   String @unique

    // Relations
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@map("devices")
}

model Event {
    id            String         @id @default(uuid())
    title         String?        @unique
    notes         String?
    date          DateTime       @default(now())
    status        StatusCard     @default(WAITING_RESPONSE)
    estimatedTime Duration       @default(HALF)
    priority      PriorityStatus @default(LOW)
    timezone      TimeZone       @default(UTC)
    slug          String         @unique
    location      StatusLocation @default(ONSITE)

    availableTimes DateTime[]
    matchedTimes   DateTime[]
    selectedTime   DateTime?

    expiredAt      DateTime?

    participants  Participant[]
    notifications Notification[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String

    @@map("events")
}

model Participant {
    id     String     @id @default(uuid())
    name   String
    slug   String?
    email  String?
    link   String
    status StatusVote @default(PENDING)

    selectedTimes DateTime[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
    eventId String

    @@map("participants")
}

model Notification {
    id        String             @id @default(uuid())
    title     String
    type      TypeNotification
    message   String
    status    StatusNotification @default(UNREAD)
    createdAt DateTime           @default(now())
    deletedAt DateTime?

    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
    eventId String

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String

    @@map("notifications")
}
